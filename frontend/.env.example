# Auth base path (optional, defaults to '/auth')
#
# Best left same-origin. The refresh token is a cookie the browser attributes to
# whichever host answered, so proxying /auth through the static host (Vercel
# rewrite, nginx location, or Vite's dev proxy) keeps it first-party — and a
# first-party cookie needs neither SameSite=None nor https to be stored.
VITE_AUTH_URL=/auth

# Backend API URL (optional, defaults to '/generate/text/')
VITE_API_URL=/generate/text/

# File Upload URL (optional, defaults to '/upload/file/')
VITE_UPLOAD_URL=/upload/file/

# Conversations base URL (optional, defaults to '/conversations/')
VITE_CONVERSATIONS_URL=/conversations/

# Model list URL (optional, defaults to '/models/')
VITE_MODELS_URL=/models/

# ---------------------------------------------------------------------------
# Production only (Vercel)
# ---------------------------------------------------------------------------
# Absolute URL of the transcription WebSocket.
#
# The paths above stay relative in production too, because `middleware.ts`
# forwards them to the backend and the browser keeps seeing one origin - which
# is what keeps the refresh cookie first-party. A WebSocket cannot use that
# route: the forwarding hop does not carry an Upgrade handshake, so the socket
# has to go to the backend's own domain directly. The access token rides as the second
# `Sec-WebSocket-Protocol` subprotocol (see `useVoiceInput.ts` and
# `_token_from_subprotocols` in the transcription router), since a handshake
# cannot set an Authorization header.
#
# Leave it unset for `npm run dev` and for the nginx parity harness, where
# same-origin already works. Whatever origin serves the page must appear in the
# backend's ALLOWED_WEBSOCKET_ORIGINS, which checks the handshake.
#
# VITE_WS_URL=wss://talk-to-web-api.onrender.com/ws/transcribe/

# ---------------------------------------------------------------------------
# Vercel project setting, not a Vite variable
# ---------------------------------------------------------------------------
# BACKEND_URL is the origin `middleware.ts` forwards the API paths to. It is
# read on the server at request time, so it never reaches the browser bundle and
# needs no VITE_ prefix. Set it in the Vercel project's environment variables.
#
# BACKEND_URL=https://talk-to-web-api.onrender.com
