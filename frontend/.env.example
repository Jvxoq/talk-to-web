# Auth base path (optional, defaults to '/auth').
# Keep it same-origin, so the refresh cookie stays first-party.
VITE_AUTH_URL=/auth

# Backend API URL (optional, defaults to '/generate/text/')
VITE_API_URL=/generate/text/

# File Upload URL (optional, defaults to '/upload/file/')
VITE_UPLOAD_URL=/upload/file/

# Conversations base URL (optional, defaults to '/conversations/')
VITE_CONVERSATIONS_URL=/conversations/

# Model list URL (optional, defaults to '/models/')
VITE_MODELS_URL=/models/

# ---------------------------------------------------------------------------
# Production only (Vercel)
# ---------------------------------------------------------------------------
# Absolute URL of the transcription WebSocket.
#
# The paths above stay relative in production, because `middleware.ts`
# forwards them. A WebSocket cannot pass through that hop, so it connects to
# the backend directly. The token rides as a subprotocol (see
# `useVoiceInput.ts`).
#
# Leave unset for `npm run dev`. The page's origin must be in the backend's
# ALLOWED_WEBSOCKET_ORIGINS.
#
# VITE_WS_URL=wss://talk-to-web-api.onrender.com/ws/transcribe/

# ---------------------------------------------------------------------------
# Vercel project setting, not a Vite variable
# ---------------------------------------------------------------------------
# The origin `middleware.ts` forwards API paths to. Read on the server, so no
# VITE_ prefix. Set it in the Vercel project's environment variables.
#
# BACKEND_URL=https://talk-to-web-api.onrender.com
