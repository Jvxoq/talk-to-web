# Deployment variables for `docker-compose.prod.yml`.
#
# Copy to `.env` on the EC2 box. This file holds no secrets - the application's
# keys live in `backend/.env.production` and are never interpolated into a
# compose file. What is here is what compose and Caddy need before any container
# starts.
#
#   cp .env.example .env

# The domain the backend answers on. Caddy uses it as the site address, which is
# also what it requests a Let's Encrypt certificate for - so its DNS A record must
# already point at this box, and ports 80 and 443 must be open, before the first
# request arrives.
#
# Set it to `localhost` to run the same compose file on a laptop: Caddy then
# issues a certificate from its own internal CA instead of calling Let's Encrypt.
API_DOMAIN=api.example.com
