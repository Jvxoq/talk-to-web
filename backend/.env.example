# Local development only. The deployment reads `render.yaml`, not this file.
#
#   cp .env.example .env

# API key for the provider LLM_PROVIDER names below.
LLM_API_KEY=your_llm_api_key_here

# Tavily API key, for the agent's web search tool.
TAVILY_API_KEY=your_tavily_api_key_here

# Google Gemini API key, for embeddings.
GEMINI_API_KEY=your_gemini_api_key_here

# Deepgram API key, for live speech-to-text.
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Qdrant. A full URL, since Qdrant Cloud needs https. Compose overrides this.
QDRANT_URL=http://localhost:6333

# Postgres. Compose overrides this.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/talk_to_the_web

# Signs access tokens. No default, since anyone holding it can sign in as anyone.
# Generate your own and keep it out of git:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Changing it signs out every access token at once.
JWT_SECRET=change_me_to_a_long_random_string

# Local only: plain http and same-origin, where a Secure cookie is never sent.
# Do NOT copy to a deployment. `render.yaml` sets the cross-site pair.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# ---------------------------------------------------------------------------
# Optional. Each value shown is the default in app/settings.py.
# Uncomment to override.
# ---------------------------------------------------------------------------

# local | staging | production. Anything but "local" logs JSON. Does not
# touch the schema: `alembic upgrade head` owns that.
# ENVIRONMENT=local

# DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=DEBUG

# Any provider langchain's init_chat_model supports (together, groq, openai,
# anthropic, google_genai, ollama). Switching is this plus LLM_API_KEY.
# LLM_PROVIDER=together

# Models in the UI dropdown, as a JSON list. Each must handle tool calls well.
# Measure before adding one.
# LLM_MODELS=["deepseek-ai/DeepSeek-V4-Flash-0731"]

# LLM_MAX_TOKENS=2048

# Max model -> tools -> model laps per reply.
# AGENT_MAX_TOOL_ITERATIONS=8

# Context compression. One condenser model summarizes history and shortens
# tool output. It has its own model, since rate limits are per model.
# AGENT_CONDENSER_MODEL=openai/gpt-oss-20b
# AGENT_CONDENSER_MAX_CHARS=40000
# AGENT_HISTORY_TOKEN_BUDGET=12000
# AGENT_RECENT_TOKEN_BUDGET=6000
# AGENT_TOOL_OUTPUT_TOKEN_BUDGET=3000

# Per-request token limit, checked every lap: 32000 minus LLM_MAX_TOKENS.
# Tool schemas are subtracted at startup. Retune both together.
# AGENT_MAX_REQUEST_TOKENS=29952

# Results the web search tool asks Tavily for.
# TAVILY_MAX_RESULTS=5

# URLs fetch_web_pages opens per call (at most 10), and characters kept per page.
# FETCH_WEB_MAX_URLS_PER_CALL=10
# FETCH_WEB_MAX_PAGE_CHARS=20000

# Allowed CORS origins, as a JSON list.
# CORS_ORIGINS=["http://localhost:5173"]

# Origins allowed to open the speech-to-text WebSocket, as a JSON list. CORS
# does not cover WebSockets, so the route checks this itself. Unset, it copies
# CORS_ORIGINS. Add "http://localhost:8080" for the parity harness.
# ALLOWED_WEBSOCKET_ORIGINS=["http://localhost:5173"]

# Direct (non-pooled) Postgres URL for migrations, since a pooler loses session
# state. Unset locally. See `render.yaml` for the deployed pair.
# DATABASE_MIGRATION_URL=

# SQLAlchemy connection pool size.
# DATABASE_POOL_SIZE=10

# Embedding model and vector size. Must match the Qdrant collection.
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIMENSIONS=768

# Required by Qdrant Cloud, unused locally.
# QDRANT_API_KEY=

# Qdrant collection name.
# QDRANT_COLLECTION=knowledge_base

# Chunks retrieved, and the minimum similarity score.
# RETRIEVAL_LIMIT=8
# RETRIEVAL_SCORE_THRESHOLD=0.35

# Deepgram model.
# DEEPGRAM_MODEL=nova-3

# Max upload size in bytes (25 MiB).
# MAX_UPLOAD_BYTES=26214400

# Chunk size and overlap, in characters.
# CHUNK_SIZE=1400
# CHUNK_OVERLAP=200

# Token lifetimes in seconds. An access token cannot be revoked, so keep it short.
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=1209600

# How long expired refresh rows are kept before cleanup. Longer than the TTL,
# so token reuse is still detected.
# REFRESH_TOKEN_CLEANUP_RETENTION_SECONDS=2592000

# Attempts per key per window on /auth/register, /auth/login and /auth/refresh.
# In-process, so N replicas allow N times this.
# AUTH_RATE_LIMIT_ATTEMPTS=5
# AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Trust `X-Forwarded-For` for the client IP. Only turn on when your own proxy is
# the only way in, or clients can forge it. `render.yaml` also passes
# `--forwarded-allow-ips "*"` to uvicorn. Left false behind a proxy, the per-IP
# auth limits are skipped.
# TRUST_FORWARDED_CLIENT_IP=false

# Max conversations per account. Past it, creating one is a 409. The oldest is
# never deleted to make room.
# MAX_CONVERSATIONS_PER_USER=2

# Per-user spend limits on /generate/text/ and /upload/file/, since every call
# costs money. Sized so a quick tester is not refused. In-process, per replica.
# CHAT_RATE_LIMIT_REQUESTS=10
# CHAT_RATE_LIMIT_WINDOW_SECONDS=60
# UPLOAD_RATE_LIMIT_REQUESTS=5
# UPLOAD_RATE_LIMIT_WINDOW_SECONDS=600

# One daily ceiling across all accounts, since one person can register many.
# Set it to the provider calls per day you have budgeted.
# GLOBAL_DAILY_CALL_BUDGET=200
# GLOBAL_DAILY_CALL_BUDGET_WINDOW_SECONDS=86400

# Refresh cookie name and path. The path keeps it off non-auth requests.
# REFRESH_COOKIE_NAME=refresh_token
# REFRESH_COOKIE_PATH=/auth

# ---------------------------------------------------------------------------
# Error reporting (optional)
# ---------------------------------------------------------------------------
# Unset means Sentry stays off and sends nothing.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# Share of requests traced. Chat replies are long streams, so raise it slowly.
# SENTRY_TRACES_SAMPLE_RATE=0.0

# ---------------------------------------------------------------------------
# Tracing (Langfuse, optional)
# ---------------------------------------------------------------------------
# Unset means NullTracer: nothing is sent.
# LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
# LANGFUSE_SECRET_KEY=your_langfuse_secret_key

# Langfuse host.
# LANGFUSE_HOST=https://cloud.langfuse.com

# Capture prompt and completion text. Safe, since guardrails redact first.
# LANGFUSE_CAPTURE_CONTENT=true

# Seconds shutdown waits for queued spans.
# LANGFUSE_FLUSH_TIMEOUT_SECONDS=2.0

# ---------------------------------------------------------------------------
# Guardrails (optional)
# ---------------------------------------------------------------------------
# Redact secrets and PII before the model, checkpointer or trace see them.
# GUARDRAIL_PII_REDACTION_ENABLED=true

# Refuse suspected prompt injections instead of only logging them. Off, since
# real users type "ignore the previous paragraph". Measure false positives
# against evals/datasets/benign.jsonl before turning on.
# GUARDRAIL_BLOCK_ON_INJECTION=false

# Strip instruction-like lines from tool results. The fence always applies.
# GUARDRAIL_STRIP_TOOL_INSTRUCTIONS=true

# Max characters one detector scans. Regex cannot time out on the single
# worker, so a long scan stalls every stream.
# GUARDRAIL_MAX_SCAN_CHARS=50000

# ---------------------------------------------------------------------------
# Spend accounting (optional)
# ---------------------------------------------------------------------------
# (input, output) USD per million tokens, per model. Unlisted models are
# reported as unpriced.
# MODEL_PRICES_USD_PER_MILLION={"qwen/qwen3.6-27b": [0.15, 0.60], "openai/gpt-oss-20b": [0.10, 0.50]}
