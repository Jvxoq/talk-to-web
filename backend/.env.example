# Local development. For a real deployment start from `.env.production.example`
# instead - it has the same variables with production-shaped values.
#
#   cp .env.example .env

# API key for whichever LLM provider LLM_PROVIDER names below.
LLM_API_KEY=your_llm_api_key_here

# Tavily API Key for the agent's web search tool
TAVILY_API_KEY=your_tavily_api_key_here

# Google Gemini API Key (embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# Deepgram API Key for live speech-to-text
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Qdrant vector database. A full URL, not a host and port: Qdrant Cloud serves
# HTTPS and a host/port pair cannot say so. `docker compose up` overrides this
# with http://qdrant:6333.
QDRANT_URL=http://localhost:6333

# Postgres. `docker compose up` overrides this with the compose service address.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/talk_to_the_web

# Secret that signs access tokens. No default on purpose: anyone holding it can
# mint a token for any account, so a shared fallback would be a shared master
# key. Generate your own and keep it out of git:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Changing it signs every existing access token out at once, which is also the
# fastest way to invalidate them all if one ever leaks.
JWT_SECRET=change_me_to_a_long_random_string

# Local development runs same-origin through the Vite proxy and over plain HTTP,
# where a `SameSite=None; Secure` cookie is simply never sent - so the two lines
# below are what make sign-in work at all on localhost. Do NOT copy them to a
# deployment; `.env.production.example` has the cross-site pair.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# ---------------------------------------------------------------------------
# Optional — sensible defaults in app/settings.py
# Everything below is optional. The value shown is the default that
# app/settings.py uses when the variable is not set. Uncomment to override.
# ---------------------------------------------------------------------------

# Runtime environment name (local | staging | production).
# Anything other than "local" switches logging to JSON. It does NOT control
# schema creation any more - `alembic upgrade head` owns that in every
# environment, and `docker compose up` runs it as its own service.
# ENVIRONMENT=local

# Log level (DEBUG | INFO | WARNING | ERROR)
# LOG_LEVEL=DEBUG

# LLM provider. Resolved by langchain's init_chat_model, so any of
# together | groq | openai | anthropic | google_genai | ollama works. Changing
# this and LLM_API_KEY is the whole of a provider switch - no code changes.
# LLM_PROVIDER=together

# Models offered in the UI dropdown, as a JSON list. Every entry MUST support
# tool calling reliably, or the agent cannot use its tools. Not every model that
# accepts a `tools` payload emits valid calls. Measure before adding one here.
# LLM_MODELS=["deepseek-ai/DeepSeek-V4-Flash-0731"]

# LLM_MAX_TOKENS=2048

# How many model -> tools -> model round trips one reply may take.
# AGENT_MAX_TOOL_ITERATIONS=5

# Context compression. The agent replays the whole thread on every lap, so a
# long conversation or a large tool result can blow the model's token budget.
# Two compression points - history summarization and tool-output compression -
# run through one condenser model. It uses its own model because a provider
# typically applies its rate limit per model: condensation does not spend the
# chat model's budget.
# AGENT_CONDENSER_MODEL=openai/gpt-oss-20b
# AGENT_CONDENSER_MAX_CHARS=40000
# AGENT_HISTORY_TOKEN_BUDGET=12000
# AGENT_RECENT_TOKEN_BUDGET=6000
# AGENT_TOOL_OUTPUT_TOKEN_BUDGET=3000

# Hard ceiling on one request's message tokens, checked on every lap - not
# just when the thread crosses AGENT_HISTORY_TOKEN_BUDGET. This is a
# provisional per-request budget (32000) minus LLM_MAX_TOKENS - the tool
# schema overhead is measured and subtracted automatically at startup, not
# baked into this number. Retune both together if either changes.
# AGENT_MAX_REQUEST_TOKENS=29952

# How many search results the web search tool asks Tavily for.
# TAVILY_MAX_RESULTS=5

# How many URLs the fetch_web_pages tool will open in one call (a tighter,
# tunable bound under the tool's own hard ceiling of 10), and how many
# characters of each page survive truncation when several are joined into
# one blob for a chat turn.
# FETCH_WEB_MAX_URLS_PER_CALL=10
# FETCH_WEB_MAX_PAGE_CHARS=20000

# Allowed CORS origins. Parsed as a JSON list, so it must be valid JSON.
# CORS_ORIGINS=["http://localhost:5173"]

# Origins allowed to open the speech-to-text WebSocket, as a JSON list.
# CORS middleware never runs on a WebSocket handshake, so this is a separate,
# explicit check in the route - without it, anyone who knows the URL can open a
# socket and spend the deployment's Deepgram budget. Left unset it mirrors
# CORS_ORIGINS, which is right whenever the page allowed to call the API is the
# page allowed to talk. The parity harness serves the frontend on :8080, so add
# "http://localhost:8080" when running it.
# ALLOWED_WEBSOCKET_ORIGINS=["http://localhost:5173"]

# Direct (non-pooled) Postgres URL for `alembic upgrade head`. Unset locally,
# where there is no pooler and DATABASE_URL is used for migrations too. See
# `.env.production.example` for why a managed database needs the distinction.
# DATABASE_MIGRATION_URL=

# SQLAlchemy connection pool size
# DATABASE_POOL_SIZE=10

# Embedding model and vector width (must match the Qdrant collection)
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIMENSIONS=768

# Qdrant API key. Required by Qdrant Cloud, unused by a local container.
# QDRANT_API_KEY=

# Qdrant collection name
# QDRANT_COLLECTION=knowledge_base

# Retrieval: how many chunks to fetch and the minimum similarity score
# RETRIEVAL_LIMIT=8
# RETRIEVAL_SCORE_THRESHOLD=0.35

# Deepgram speech-to-text model
# DEEPGRAM_MODEL=nova-3

# Maximum accepted upload size in bytes (25 MiB)
# MAX_UPLOAD_BYTES=26214400

# Document chunking, in characters
# Characters, not tokens. Roughly a paragraph or two per chunk.
# CHUNK_SIZE=1400
# CHUNK_OVERLAP=200

# Token lifetimes, in seconds. The access token cannot be revoked before it
# expires - verification never touches the database - so this is the window a
# signed-out session keeps working. The refresh token is a row, so it can be.
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=1209600

# How long an expired refresh_tokens row lingers before the cleanup job (see
# app/cleanup_expired_refresh_tokens.py) deletes it. Kept well past
# REFRESH_TOKEN_TTL_SECONDS on purpose - a replayed, already-revoked token is
# still worth detecting for a while after it stops being usable.
# REFRESH_TOKEN_CLEANUP_RETENTION_SECONDS=2592000

# Brute-force budget on /auth/register, /auth/login and /auth/refresh: this many
# attempts per key per window. Counted in-process, so each replica keeps its own
# tally - N replicas allow N times the budget.
# AUTH_RATE_LIMIT_ATTEMPTS=5
# AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Spend budget per signed-in user on /generate/text/ and /upload/file/. These
# exist for a different reason than the one above: not to stop password
# guessing, but because every reply and every accepted upload costs real tokens
# at the LLM and embedding providers, and an account left looping in a script
# spends money that is not theirs. Counted in-process, per account, same
# per-replica caveat as above.
#
# Set tight on purpose: three replies a minute and two uploads every ten
# minutes. A fast reader will meet them. Raise them only against a bill someone
# has agreed to pay.
# How many conversations one account may hold at once. Past it, creating
# another answers 409 and the client is told to delete one - never resolved by
# evicting the oldest thread, which would destroy work nobody offered up. Each
# thread owns its own uploads, so this also caps how many files an account can
# keep indexed.
# MAX_CONVERSATIONS_PER_USER=2

# CHAT_RATE_LIMIT_REQUESTS=3
# CHAT_RATE_LIMIT_WINDOW_SECONDS=60
# UPLOAD_RATE_LIMIT_REQUESTS=2
# UPLOAD_RATE_LIMIT_WINDOW_SECONDS=600

# Deployment-wide spend ceiling, on top of the per-user ones above. One
# counter, hit by every chat reply, upload, URL ingestion and transcription
# session regardless of which account made it - registration has no CAPTCHA,
# so the per-user limits alone only cap how fast *one* account can spend, not
# how many accounts someone is willing to create. Set this to whatever number
# of provider calls per day you have actually budgeted for.
# GLOBAL_DAILY_CALL_BUDGET=200
# GLOBAL_DAILY_CALL_BUDGET_WINDOW_SECONDS=86400

# Name of the refresh cookie, and the path it is scoped to. The path keeps it
# off every chat request and upload; only /auth needs it.
# REFRESH_COOKIE_NAME=refresh_token
# REFRESH_COOKIE_PATH=/auth

# ---------------------------------------------------------------------------
# Error reporting (optional)
# ---------------------------------------------------------------------------
# Unset means Sentry is never initialized - nothing is sent and no key is
# needed, which is the right default for a laptop. Set it to point a local run
# at a scratch Sentry project.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# Whole-request performance tracing, as a fraction. Off by default: a chat reply
# holds a stream open for the length of a model call, so traces here are long
# and expensive. Raise it in small steps.
# SENTRY_TRACES_SAMPLE_RATE=0.0

# ---------------------------------------------------------------------------
# Tracing (Langfuse, optional)
# ---------------------------------------------------------------------------
# Unset means the tracer runs as NullTracer - nothing is sent and no keys are
# needed, which is the right default for a laptop. Set both to point a local run
# at a Langfuse project (cloud free tier, not self-hosted).
# LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
# LANGFUSE_SECRET_KEY=your_langfuse_secret_key

# Langfuse host (defaults to cloud)
# LANGFUSE_HOST=https://cloud.langfuse.com

# Whether prompts and completions are captured in traces. On by default because
# a trace without text is just a latency chart. Safe because input guardrails
# redact before any span opens.
# LANGFUSE_CAPTURE_CONTENT=true

# How long shutdown waits for queued spans, in seconds. Bounded below the
# compose stop_grace_period to avoid hanging on a failed tracing backend.
# LANGFUSE_FLUSH_TIMEOUT_SECONDS=2.0

# ---------------------------------------------------------------------------
# Guardrails (optional)
# ---------------------------------------------------------------------------
# Redact secrets and personal data from the user's message before it reaches
# the model, checkpointer, or trace. Redacted text is what downstream systems see.
# GUARDRAIL_PII_REDACTION_ENABLED=true

# Whether a suspected prompt injection is refused or merely recorded.
# Off by default: "Ignore the previous paragraph" is a sentence a real user types
# at a real PDF. Flag first, measure false positives against evals/datasets/benign.jsonl,
# then turn on.
# GUARDRAIL_BLOCK_ON_INJECTION=false

# Strip instruction-shaped lines out of tool results. The fence is always applied;
# this is a sharper pass on top.
# GUARDRAIL_STRIP_TOOL_INSTRUCTIONS=true

# How much text a single detector will scan, in characters. A concurrency limit
# wearing a size limit's clothes: regex is sync, this runs one worker with
# --limit-concurrency 5, Python has no regex timeout, and a long match stalls
# every open stream. A user message is capped at 32k by the schema; tool results
# can be ten pages at 20k each.
# GUARDRAIL_MAX_SCAN_CHARS=50000

# ---------------------------------------------------------------------------
# Spend accounting (optional)
# ---------------------------------------------------------------------------
# (input, output) USD per million tokens, keyed by model name. Prices move when
# providers move them, so they live here rather than in code. Models missing from
# this map still answer; their cost is reported as unpriced rather than zero.
# MODEL_PRICES_USD_PER_MILLION={"qwen/qwen3.6-27b": [0.15, 0.60], "openai/gpt-oss-20b": [0.10, 0.50]}
