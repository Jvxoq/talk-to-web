# Prod-parity overrides, loaded *after* `backend/.env.production` by
# `docker-compose.parity.yml` (Compose appends `env_file` lists rather than
# replacing them, so keys set here win and everything else — JWT_SECRET,
# LLM_API_KEY, CORS_ORIGINS, etc. — still comes from `.env.production`).
#
#   cp backend/.env.parity.example backend/.env.parity   # then fill it in
#   docker compose -f docker-compose.prod.yml -f docker-compose.parity.yml \
#     --profile parity up --build
#
# The point of this file is to make a parity run exercise the real Neon
# pooler/TLS behavior without ever touching production data. Qdrant needs no
# entry here at all — `docker-compose.parity.yml` points it at a throwaway
# local container instead of Qdrant Cloud (Qdrant has no branch equivalent,
# so a parity run touching the real cluster would mean reading and
# overwriting production's real vectors).

# ---------------------------------------------------------------------------
# Postgres — Neon, but a DEV BRANCH, not `main`
# ---------------------------------------------------------------------------
# Create a branch off `main` (Neon MCP: `create_branch`, or the console) and
# use its own pooled/direct connection strings here — never the ones from
# `.env.production`. A dev branch starts as a full copy-on-write clone of
# `main`, so schema and data look real, but writes here never reach
# production. `reset_from_parent` gives you a clean copy again whenever the
# branch drifts too far to be useful.
DATABASE_URL=postgresql+psycopg://user:password@ep-example-dev-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_MIGRATION_URL=postgresql+psycopg://user:password@ep-example-dev-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Readiness probe timeout
# ---------------------------------------------------------------------------
# A dev branch that has been idle scales to zero; the first connection after
# that has to wake it, which routinely takes longer than the 2s default in
# app/settings.py. Give /ready room to wait for a cold Neon branch instead of
# reporting a false 503.
READINESS_TIMEOUT_SECONDS=10
