# Prod-parity overrides, loaded *after* `backend/.env.production` by
# `docker-compose.parity.yml` (Compose appends `env_file` lists rather than
# replacing them, so keys set here win and everything else — JWT_SECRET,
# LLM_API_KEY, ENVIRONMENT, etc. — still comes from `.env.production`).
#
#   cp backend/.env.parity.example backend/.env.parity   # then fill it in
#   docker compose -f docker-compose.prod.yml -f docker-compose.parity.yml \
#     --profile parity up --build
#
# The point of this file is to make a parity run exercise the real Neon and
# Qdrant Cloud wire behavior — pooling, TLS, cold starts — without ever
# touching production data. Postgres is a dev branch of the same database;
# Qdrant is a separate collection on the same cluster. Neither can read or
# write what production reads and writes.

# ---------------------------------------------------------------------------
# Postgres — Neon, but a DEV BRANCH, not `main`
# ---------------------------------------------------------------------------
# Create a branch off `main` (Neon MCP: `create_branch`, or the console) and
# use its own pooled/direct connection strings here — never the ones from
# `.env.production`. A dev branch starts as a full copy-on-write clone of
# `main`, so schema and data look real, but writes here never reach
# production. `reset_from_parent` gives you a clean copy again whenever the
# branch drifts too far to be useful.
DATABASE_URL=postgresql+psycopg://user:password@ep-example-dev-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_MIGRATION_URL=postgresql+psycopg://user:password@ep-example-dev-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Qdrant — same Cloud cluster as production, but a DEV COLLECTION
# ---------------------------------------------------------------------------
# Same cluster URL and API key as `.env.production`, but QDRANT_COLLECTION
# names a collection that doesn't need to exist yet — the app creates it on
# first ingest (`QdrantVectorIndex.ensure`). Because it's a different
# collection, this can never read or overwrite production's vectors even
# though it's the same cluster and the same key.
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key
QDRANT_COLLECTION=knowledge_base_dev

# ---------------------------------------------------------------------------
# Readiness probe timeout
# ---------------------------------------------------------------------------
# A dev branch that has been idle scales to zero; the first connection after
# that has to wake it, which routinely takes longer than the 2s default in
# app/settings.py. Give /ready room to wait for a cold Neon branch instead of
# reporting a false 503.
READINESS_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Origins — the local parity frontend, not the real Vercel domain
# ---------------------------------------------------------------------------
# `backend/.env.production`'s CORS_ORIGINS/ALLOWED_WEBSOCKET_ORIGINS name the
# real Vercel domain, which this box is never served from during a parity run
# — the parity frontend is nginx on :8080 instead. Override both here so a
# parity run is actually reachable from the browser it's served to.
CORS_ORIGINS=["http://localhost:8080"]
ALLOWED_WEBSOCKET_ORIGINS=["http://localhost:8080"]
