# Production values, loaded by `docker-compose.prod.yml` into the `backend` and
# `migrate` containers.
#
#   cp .env.production.example .env.production   # on the EC2 box, then fill in
#
# `.env.production` is gitignored and excluded from the image build context, so
# it exists only on the machine that runs it. Nothing in here is interpolated
# into a compose file or baked into a layer.
#
# ENVIRONMENT is deliberately absent: `docker-compose.prod.yml` sets it to
# `production` in the compose file itself, because a missing value here would
# silently fall back to "local" rather than fail.

# ---------------------------------------------------------------------------
# Postgres — Neon
# ---------------------------------------------------------------------------
# Two endpoints for one database, and the difference matters.
#
# DATABASE_URL is the POOLED endpoint - the hostname with `-pooler` in it. The
# application holds a connection pool of its own on top of PgBouncer, which is
# what lets a scaled-to-zero compute wake up without the app exhausting its
# connection budget. `?sslmode=require` is not optional; Neon refuses plaintext.
DATABASE_URL=postgresql+psycopg://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# DATABASE_MIGRATION_URL is the DIRECT endpoint - the same hostname without
# `-pooler`. `alembic upgrade head` runs DDL, and a transaction pooler may hand
# the connection to another client between statements, losing the session state
# a migration depends on. Alembic gets its own connection, straight to the
# compute, for the seconds it takes to run.
DATABASE_MIGRATION_URL=postgresql+psycopg://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Qdrant Cloud
# ---------------------------------------------------------------------------
# The full HTTPS endpoint from the cluster's dashboard, port included.
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key
QDRANT_COLLECTION=knowledge_base

# ---------------------------------------------------------------------------
# Origins
# ---------------------------------------------------------------------------
# The Vercel domain serving the frontend, as a JSON list.
#
# Ordinary API calls arrive same-origin as far as the browser is concerned -
# Vercel rewrites /generate, /upload, /conversations and /models to this backend
# - so CORS_ORIGINS is a backstop rather than the main path.
CORS_ORIGINS=["https://app.example.com"]

# The WebSocket is the exception: it bypasses Vercel and connects to this
# backend directly, so its handshake really is cross-origin, and CORS middleware
# does not run on handshakes at all. This list is checked by the route itself.
# Unset it mirrors CORS_ORIGINS, which is usually exactly right - name it here
# only if the two must differ.
ALLOWED_WEBSOCKET_ORIGINS=["https://app.example.com"]

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Signs every access token. Anyone holding it can mint a token for any account,
# so it belongs here and nowhere else - not in the compose file, not in the
# image. Generate a fresh one for this deployment:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Rotating it signs everybody out, which is the correct response to a leak.
JWT_SECRET=generate_a_long_random_secret_for_this_deployment

# The frontend is on Vercel and this API is on its own domain, so the refresh
# cookie is cross-site: it is only sent at all with `SameSite=None`, and
# browsers refuse `SameSite=None` without `Secure`. Both are the defaults; they
# are spelled out here because getting either wrong presents as "sign-in works,
# then the user is signed out on reload".
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=none

# Set only if the API and the frontend share a registrable parent domain and you
# want the cookie sent to both (".example.com"). Leave unset otherwise - a
# domain attribute widens where the cookie travels.
# REFRESH_COOKIE_DOMAIN=

# Whether the address on the connection is the caller's rather than the proxy's.
# Only turn this on once uvicorn is started with `--forwarded-allow-ips` set to
# the proxy in front of it. With it on and that missing, every request looks like
# it comes from the proxy, and the per-IP rate limit becomes one shared bucket
# that one bad actor can close for everybody.
# TRUST_FORWARDED_CLIENT_IP=false

# ---------------------------------------------------------------------------
# Provider keys
# ---------------------------------------------------------------------------
LLM_API_KEY=your_llm_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ---------------------------------------------------------------------------
# Operational
# ---------------------------------------------------------------------------
# DEBUG logs every prompt and tool result at volume, and the JSON formatter this
# environment turns on makes them expensive to ship as well as noisy.
LOG_LEVEL=INFO

# Keep the pool well under Neon's connection limit for the plan, counting every
# container that talks to the same database.
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=5

# LLM_PROVIDER=together
# LLM_MODELS=["deepseek-ai/DeepSeek-V4-Flash-0731"]
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIMENSIONS=768

# ---------------------------------------------------------------------------
# Error reporting
# ---------------------------------------------------------------------------
# Where unhandled 500s go. Leave it unset and there is no error reporting at
# all: the traceback exists only in this container's stdout, and whoever is on
# call finds out from a user. Every event is tagged with the request id that
# produced it, which is the same id the response carried in `X-Request-ID` and
# the same one in the JSON log line.
#
# PII is deliberately not sent - no cookies, no bearer tokens, no request bodies
# - so a Sentry event never contains a refresh token or a user's chat.
SENTRY_DSN=

# What identifies this build. Set it to the commit SHA or image tag being
# deployed; without it Sentry files every event under one release and "new since
# the last deploy" stops meaning anything.
# SENTRY_RELEASE=

# Fraction of requests traced for performance. Off by default, and worth leaving
# off here: a chat reply holds a stream open for the length of a model call.
# SENTRY_TRACES_SAMPLE_RATE=0.0
