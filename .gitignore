# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# uv
uv.lock.bak

# Environment variables / secrets
# `.env.*` already covers `.env.production`; the negations are what keep the
# templates tracked, since the glob swallows them too.
.env
.env.*
!.env.example
!.env.production.example
!.env.parity.example

# Uploaded files
backend/uploads/
uploads/

# Testing / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# Generated by the CI audit step (`uv export`), and by anyone reproducing it
backend/requirements-audit.txt

# Node / frontend
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# `tsc -b` incremental build state. Machine- and timestamp-specific, rewritten by
# every build, and useless to anyone else - tracking it meant `npm run build`
# dirtied the working tree every time.
*.tsbuildinfo

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude
.claude/
CLAUDE.md